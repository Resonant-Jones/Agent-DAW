# The Codexify-side engine pin, as proposed.
#
# PR #1005 (fix(music): pin the engine to a tag that can carry the job's
# context), opened 2026-11-05. The branch also carries Resonant's own
# "docs(music): keep ADR-108 anchored to Compose engine pin", the merge of
# the then-current main, and the qualification-registry regeneration that
# the compose change requires.
#
# Apply onto 96e9444e6, or onto any later commit that has not changed
# docker-compose.yml, plugins/agentdaw/manifest.json,
# docs/architecture/adr/108-... or docs/qualification/registry.json.
#
# The compose service pinned the Agent-DAW engine at v0.1.2, which predates
# the job context echo (v0.1.3). The route's async path reads the project
# id back out of `result.get("context")`; with a v0.1.2 engine that is
# empty, the registration is skipped with a warning, and the route still
# reports success. The files are produced and none of them are registered.
#
# docs/qualification/registry.json is in this patch because
# docker-compose.yml and plugins/agentdaw/manifest.json are both in the
# `supported-compose-stock` rubric's surface_paths. The registry has to be
# regenerated in the same change or it states something untrue. Generate it
# with full repository history: a shallow clone resolves the qualification
# run's tested commit as outside the tip's lineage and emits a different,
# false registry.
#
diff --git a/docker-compose.yml b/docker-compose.yml
index c05ff88ad..2d0f03b90 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -1050,8 +1050,16 @@ services:
       - music
     # Built from the Agent-DAW repository at a tagged release. Point
     # CODEXIFY_AGENTDAW_BUILD_CONTEXT at a local checkout for development.
+    #
+    # The tag is part of the contract, not a formality. The route's async
+    # path reads the project id back out of the job's echoed context, and
+    # the engine only started carrying that context in v0.1.3. On v0.1.2
+    # the files are produced, the registration is skipped with a warning,
+    # and the route still reports success -- so nothing is registered.
+    # Verified against images built from the tags themselves: v0.1.2
+    # answers `"context": null`, v0.1.5 answers with the context.
     build:
-      context: "${CODEXIFY_AGENTDAW_BUILD_CONTEXT:-https://github.com/Resonant-Jones/Agent-DAW.git#v0.1.2}"
+      context: "${CODEXIFY_AGENTDAW_BUILD_CONTEXT:-https://github.com/Resonant-Jones/Agent-DAW.git#v0.1.6}"
       dockerfile: Dockerfile
     working_dir: /app
     environment:
