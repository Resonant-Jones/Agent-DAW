+def _include_music_projects_router() -> None:
+    """Mount the Music Project routes and Agent-DAW's producer routes.
+
+    The two are mounted separately on purpose. The Music Project state
+    endpoints are ordinary Codexify routes and are always available. The
+    producer routes come from Agent-DAW, an optional extra, and are
+    imported inside the function rather than at module scope: if Agent-DAW
+    is not installed, a missing capability must not stop Codexify from
+    booting, and a top-level import would do exactly that.
+
+    The cost of degrading instead of raising is that the producer routes
+    vanish from the OpenAPI schema, and therefore from the command-bus
+    manifest, and therefore from the model's tool list. That is a silent
+    loss of capability, so the failure is logged loudly rather than
+    swallowed.
+    """
+    app.include_router(music_projects.router)
+
+    try:
+        app.include_router(music_projects.build_producer_router())
+    except Exception:
+        logger.exception(
+            "[routers] agentdaw is not importable; the producer routes are "
+            "not mounted and the Producer is not callable by the model"
+        )
 
 
